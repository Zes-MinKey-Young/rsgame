# 本地开发：随便一个 Postgres 都行（Docker 起一个最省事，见 README）
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/rsgame

# Netlify 部署时自动注入 NETLIFY_DATABASE_URL，优先级高于 DATABASE_URL，无需配置

# JWT 签名密钥，生产环境务必替换成足够长的随机串
JWT_SECRET=change-me-to-a-long-random-string

# root 账号初始密码（仅 db:seed 时使用）
ROOT_PASSWORD=change-me-root-password

# 服务条款里显示的运营主体名称（构建时注入，留空则显示占位文案）
PUBLIC_OPERATOR=
