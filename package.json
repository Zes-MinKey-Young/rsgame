{
  "name": "rsgame-serverless",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:web": "vite dev",
    "dev:api": "bun --watch src/dev.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "i18n:types": "bun run scripts/type-i18n.ts",
    "i18n:check": "bun run scripts/check-locales.ts",
    "i18n:watch": "bun run scripts/type-i18n.ts --watch",
    "prepare": "svelte-kit sync && bun run scripts/type-i18n.ts || echo ''",
    "db:up": "docker run -d --name rsgame-pg -p 55432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=rsgame postgres:16-alpine",
    "db:down": "docker rm -f rsgame-pg",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@netlify/database": "^2.0.3",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "postgres": "^3.4.5",
    "svelte-i18n": "^4.0.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.0",
    "js-yaml": "^4.1.0",
    "svelte": "^5.54.0",
    "svelte-check": "^4.4.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
